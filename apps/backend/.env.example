NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=*
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
DATABASE_URL=postgres://user:password@host:5432/postgres
ADMIN_API_TOKEN=cambia-esto-por-un-token-largo-y-secreto
SESSION_TOKEN_SECRET=cambia-esto-por-un-secreto-de-32-chars-o-mas
# Tools nativas de plataforma (automatizacion web asincrona). Opcionales: si faltan, la feature se
# desactiva y los agentes no reciben tools nativas (comportamiento identico al actual). Cuando estan
# ambas, las tools platform_* se inyectan en TODOS los agentes y los POST al worker se firman con
# WEB_WORKER_SECRET (HMAC, NO el whsec_ por agente). El secreto debe tener 32+ caracteres.
WEB_WORKER_URL=https://web-worker.tu-dominio.com
WEB_WORKER_SECRET=cambia-esto-por-un-secreto-de-plataforma-de-32-chars-o-mas
