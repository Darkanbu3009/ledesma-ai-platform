NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=*
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
DATABASE_URL=postgres://user:password@host:5432/postgres
ADMIN_API_TOKEN=cambia-esto-por-un-token-largo-y-secreto
SESSION_TOKEN_SECRET=cambia-esto-por-un-secreto-de-32-chars-o-mas
# Secreto maestro de la BOVEDA DE CREDENCIALES: cifra y descifra (AES-256-GCM) las API keys que el
# usuario guarda en /v1/credentials. REQUERIDO (la boveda no funciona sin el) y SEPARADO de
# SESSION_TOKEN_SECRET a proposito, para poder rotar cada secreto de forma independiente. 32+ caracteres.
VAULT_SECRET=cambia-esto-por-un-secreto-de-boveda-de-32-chars-o-mas
# Tools nativas de plataforma (automatizacion web asincrona). Opcionales: si faltan, la feature se
# desactiva y los agentes no reciben tools nativas (comportamiento identico al actual). Cuando estan
# ambas, las tools platform_* se inyectan en TODOS los agentes y los POST al worker se firman con
# WEB_WORKER_SECRET (HMAC, NO el whsec_ por agente). El secreto debe tener 32+ caracteres.
WEB_WORKER_URL=https://web-worker.tu-dominio.com
WEB_WORKER_SECRET=cambia-esto-por-un-secreto-de-plataforma-de-32-chars-o-mas
# SERVICE_ROLE_KEY de Supabase: llave del rol de servicio (Project Settings > API > service_role). Habilita
# el ADMIN API de auth (borrar auth.users) del MOTOR DE BORRADO DE CUENTA. Es una llave MUY PODEROSA:
# bypasa RLS y da acceso total. TRATAR COMO SECRETO MAXIMO -> solo en el entorno del backend, NUNCA en el
# cliente/consola, NUNCA en logs ni en el control de versiones. OPCIONAL: si falta, el borrado de DATOS
# (Postgres, atomico) funciona igual y el borrado de auth.users queda desactivado ('not_configured').
SUPABASE_SERVICE_ROLE_KEY=cambia-esto-por-la-service-role-key-de-supabase
