{
  "name": "@ledesma-platform/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plans": {
      "types": "./dist/plans/plans.d.ts",
      "import": "./src/plans/plans.ts"
    },
    "./relay-token": {
      "types": "./dist/relay/relay-token.d.ts",
      "import": "./dist/relay/relay-token.js"
    },
    "./relay-protocol": {
      "types": "./dist/relay/protocol.d.ts",
      "import": "./dist/relay/protocol.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "vitest": "^4.1.8"
  }
}
